#!/bin/bash

# Get project root to ensure we run bazel from the right place
REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT" || exit 1

if [ "$SKIP_TESTS" = "1" ]; then
    echo "SKIP_TESTS=1 is set, skipping pre-commit tests."
    exit 0
fi

echo "Running pre-commit tests (bazel test //backend/...)..."
start_time=$(date +%s)

# Using .bazel-user-root in the project directory to avoid permission issues 
# with default /var/tmp location in the sandbox environment.
bazel --output_user_root="$REPO_ROOT/.bazel-user-root" test //backend/... 2>&1
exit_code=$?

end_time=$(date +%s)
elapsed=$((end_time - start_time))

if [ $exit_code -ne 0 ]; then
    echo "Tests failed with exit code $exit_code! Commit aborted."
    echo "Elapsed time: ${elapsed}s"
    exit $exit_code
fi

echo "Tests passed! Elapsed time: ${elapsed}s"
exit 0
